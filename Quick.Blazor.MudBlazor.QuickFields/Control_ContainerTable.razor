@using Quick.Fields

<div class="@ControlUtils.GetTableClass(Field)">
    <div class="mud-table-container">
        <table class="mud-table-root" style="@Field.Html_Style">
            @if (Field.Children != null)
            {
                @foreach (var child in Field.Children)
                {
                    <Control Field="@child" />
                }
            }
        </table>
    </div>
</div>

@code
{
    [Parameter]
    public FieldForGet Field { get; set; }
}